---
import type { ImageMetadata } from 'astro';
import BaseHead from '@/components/layout/BaseHead.astro';
import Footer from '@/components/layout/Footer.astro';
import Header from '@/components/layout/Header.astro';
import { getLangFromUrl } from '@/i18n/utils';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	class?: string;
}

const { title, description, image, class: mainClass } = Astro.props;
const lang = getLangFromUrl(Astro.url);
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={title} description={description} image={image} />
		{/* Runs before first paint so a dark-mode visitor never sees a white flash. */}
		<script is:inline>
			(() => {
				let stored = null;
				try {
					stored = localStorage.getItem('theme');
				} catch {}
				// Nothing stored means "system": follow the OS instead of a saved choice.
				const mode = stored === 'light' || stored === 'dark' ? stored : 'system';
				const dark =
					mode === 'dark' ||
					(mode === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
				document.documentElement.dataset.theme = mode;
				document.documentElement.classList.toggle('dark', dark);
			})();
		</script>
	</head>
	{/* The column layout keeps the footer at the bottom on short pages. */}
	<body
		class="flex min-h-screen flex-col bg-surface text-body antialiased"
	>
		<Header />
		<main class:list={['mx-auto w-full max-w-2xl grow px-4 py-12', mainClass]}>
			<slot />
		</main>
		<Footer />
	</body>
</html>
