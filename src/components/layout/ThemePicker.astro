---
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const modes = [
	{ mode: 'light', label: t('theme.light') },
	{ mode: 'dark', label: t('theme.dark') },
	{ mode: 'system', label: t('theme.system') },
] as const;
---

<details class="theme-picker relative flex" data-dropdown>
	<summary
		aria-label={t('theme.label')}
		class="group font-nothing-subtitle flex cursor-pointer list-none items-center gap-2 border-s border-border px-4 text-caption transition-colors duration-150 md:px-6"
	>
		{/* On a phone the value alone carries the cell; the field name would crowd it. */}
		<span class="hidden sm:inline">{t('theme.label')}</span>
		{/* All three ship in the markup; CSS shows the one `data-theme` names. */}
		<span class="min-w-[7ch] font-bold text-title">
			{modes.map(({ mode, label }) => <span class:list={['state', `state-${mode}`]}>{label}</span>)}
		</span>
	</summary>

	<ul class="absolute end-0 top-full z-10 min-w-40 border border-outline bg-raised py-1">
		{
			modes.map(({ mode, label }) => (
				<li>
					<button
						type="button"
						data-mode={mode}
						class="option font-nothing-subtitle flex min-h-11 w-full cursor-pointer items-center border-s-2 border-transparent px-4 text-start text-caption transition-colors duration-150 hover:text-body"
					>
						{label}
					</button>
				</li>
			))
		}
	</ul>
</details>

<style>
	/* Safari still paints the default disclosure triangle without this. */
	summary::-webkit-details-marker {
		display: none;
	}

	.state {
		display: none;
	}
	/*
	  `data-theme` lands on <html> before first paint, so the summary shows the
	  right state from the start instead of after the script runs.
	*/
	:global(html[data-theme='light']) .state-light,
	:global(html[data-theme='dark']) .state-dark,
	:global(html[data-theme='system']) .state-system {
		display: inline;
	}

	/*
	  Same reason: mark the active option without waiting on JavaScript. The 2px
	  bar is the one accent moment in this control — the label itself just steps
	  up the neutral ramp.
	*/
	:global(html[data-theme='light']) .option[data-mode='light'],
	:global(html[data-theme='dark']) .option[data-mode='dark'],
	:global(html[data-theme='system']) .option[data-mode='system'] {
		border-inline-start-color: var(--color-accent);
		color: var(--color-title);
	}
</style>

<script>
	import '@/scripts/dropdown';

	const MODES = ['light', 'dark', 'system'] as const;
	type Mode = (typeof MODES)[number];

	const picker = document.querySelector<HTMLDetailsElement>('.theme-picker');
	const root = document.documentElement;
	const prefersDark = window.matchMedia('(prefers-color-scheme: dark)');

	function currentMode(): Mode {
		const mode = root.dataset.theme;
		return MODES.includes(mode as Mode) ? (mode as Mode) : 'system';
	}

	/** "system" has no colour of its own — it defers to the OS setting. */
	function resolvesToDark(mode: Mode): boolean {
		return mode === 'dark' || (mode === 'system' && prefersDark.matches);
	}

	function syncPressed(mode: Mode) {
		for (const option of picker?.querySelectorAll<HTMLButtonElement>('.option') ?? []) {
			option.setAttribute('aria-pressed', String(option.dataset.mode === mode));
		}
	}

	function apply(mode: Mode) {
		root.dataset.theme = mode;
		root.classList.toggle('dark', resolvesToDark(mode));
		syncPressed(mode);
		try {
			// Storing nothing *is* the "system" state, which is what the inline script reads.
			if (mode === 'system') localStorage.removeItem('theme');
			else localStorage.setItem('theme', mode);
		} catch {
			// Storage can be unavailable (private mode); the theme still applies for this page.
		}
	}

	syncPressed(currentMode());

	picker?.addEventListener('click', (event) => {
		const option = (event.target as HTMLElement).closest<HTMLButtonElement>('.option');
		const mode = option?.dataset.mode as Mode | undefined;
		if (!mode) return;

		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const commit = () => {
			apply(mode);
			picker.open = false;
		};

		// `startViewTransition` cross-fades the whole page instead of snapping colours.
		if (document.startViewTransition && !reducedMotion) {
			document.startViewTransition(commit);
		} else {
			commit();
		}
	});

	// While on "system", follow the OS if it changes with the page still open.
	prefersDark.addEventListener('change', () => {
		if (currentMode() === 'system') apply('system');
	});
</script>
