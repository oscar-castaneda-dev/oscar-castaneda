---
import { getLangFromUrl, localizedPath, useTranslations } from '@/i18n/utils';

interface Props {
	links: { href: string; label: string }[];
}

const { links } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const current = Astro.url.pathname;
---

{/* Burger: three hairlines, no icon font, no SVG. */}
<button
	type="button"
	class="mobile-menu-open flex cursor-pointer flex-col justify-center gap-1.5 p-1 md:hidden"
	aria-label={t('nav.openMenu')}
	aria-expanded="false"
	aria-controls="mobile-drawer"
>
	<span class="block h-px w-5 bg-title"></span>
	<span class="block h-px w-5 bg-title"></span>
	<span class="block h-px w-5 bg-title"></span>
</button>

{/*
  The drawer ships closed and inert, parked one screen to the side. Toggling
  classes (not `hidden`) keeps the slide animation alive in both directions.
*/}
<div
	id="mobile-drawer"
	class="mobile-drawer pointer-events-none fixed inset-0 z-50 flex translate-x-full flex-col bg-surface transition-transform duration-300 ease-out motion-reduce:transition-none md:hidden"
	inert
>
	<div class="container flex items-center justify-between border-b border-border py-6">
		<a
			href={localizedPath(lang)}
			aria-label={t('nav.home')}
			class="group font-nothing-code text-title before:content-['[_'] after:content-['_]']"
		>
			<span class="relative inline-block uppercase">
				oc
				<span
					class="absolute bottom-0 left-0 w-full border-b border-title opacity-0 transition-opacity duration-150 group-hover:opacity-100"
				></span>
			</span>
		</a>

		<button
			type="button"
			class="mobile-menu-close cursor-pointer font-nothing-subtitle text-caption transition-colors duration-150 hover:text-title"
			aria-label={t('nav.closeMenu')}
		>
			[{t('nav.close')}]
		</button>
	</div>

	<nav class="container flex flex-col gap-10 pt-16">
		{
			links.map(({ href, label }) => (
				<a
					href={href}
					aria-current={current === href ? 'page' : undefined}
					class:list={[
						'font-nothing-subtitle text-2xl',
						current === href
							? 'text-accent'
							: 'text-title transition-colors duration-150 hover:text-caption',
					]}
				>
					/{label}
				</a>
			))
		}
	</nav>
</div>

<script>
	const opener = document.querySelector<HTMLButtonElement>('.mobile-menu-open');
	const closer = document.querySelector<HTMLButtonElement>('.mobile-menu-close');
	const drawer = document.querySelector<HTMLElement>('.mobile-drawer');

	function setOpen(open: boolean) {
		if (!drawer || !opener) return;

		drawer.classList.toggle('translate-x-full', !open);
		drawer.classList.toggle('pointer-events-none', !open);
		// `inert` keeps the offscreen panel out of the tab order and the a11y tree.
		drawer.toggleAttribute('inert', !open);
		opener.setAttribute('aria-expanded', String(open));
		// The page behind must not scroll while the drawer covers it.
		document.body.classList.toggle('overflow-hidden', open);

		if (open) closer?.focus();
		else opener.focus();
	}

	opener?.addEventListener('click', () => setOpen(true));
	closer?.addEventListener('click', () => setOpen(false));

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') setOpen(false);
	});

	// A link inside the drawer navigates away; close first so a bfcache restore
	// (the back button) does not bring the page back with the drawer still open.
	for (const link of drawer?.querySelectorAll('a') ?? []) {
		link.addEventListener('click', () => setOpen(false));
	}
</script>
