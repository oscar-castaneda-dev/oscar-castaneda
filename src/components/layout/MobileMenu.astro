---
import { getLangFromUrl, localizedPath, useTranslations } from '@/i18n/utils';

interface Props {
	links: { href: string; label: string }[];
}

const { links } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const current = Astro.url.pathname;
---

<!-- BURGER MENU -->
<button
	type="button"
	class="mobile-menu-open flex cursor-pointer flex-col justify-center gap-1.5 p-1 menu:hidden"
	aria-label={t('nav.openMenu')}
	aria-expanded="false"
	aria-controls="mobile-drawer"
	popovertarget="mobile-drawer"
>
	<span class="block h-px w-5 bg-title"></span>
	<span class="block h-px w-5 bg-title"></span>
	<span class="block h-px w-5 bg-title"></span>
</button>
<!-- MOBILE CONTAINER -->
<div id="mobile-drawer" class="mobile-drawer fixed inset-0 flex flex-col bg-surface menu:hidden" popover>
	<div class="container flex items-center justify-between border-b border-border py-6">
		<!-- LOGO -->
		<a
			href={localizedPath(lang)}
			aria-label={t('nav.home')}
			class="group font-nothing-code text-title before:content-['[_'] after:content-['_]']"
		>
			<span class="relative inline-block uppercase">
				oc
				<span
					class="absolute bottom-0 left-0 w-full border-b border-title opacity-0 transition-opacity duration-150 group-hover:opacity-100"
				></span>
			</span>
		</a>
		<!-- CLOSE MODAL -->
		<button
			type="button"
			class="cursor-pointer font-nothing-subtitle text-caption transition-colors duration-150 hover:text-title"
			aria-label={t('nav.closeMenu')}
			popovertarget="mobile-drawer"
			popovertargetaction="hide"
			autofocus
		>
			[{t('nav.close')}]
		</button>
	</div>
	<!-- NAVIGATION -->
	<nav class="container flex flex-col gap-10 pt-16">
		{
			links.map(({ href, label }) => (
				<a
					href={href}
					aria-current={current === href ? 'page' : undefined}
					class:list={[
						'font-nothing-subtitle text-2xl',
						current === href
							? 'text-accent'
							: 'text-title transition-colors duration-150 hover:text-caption',
					]}
				>
					/{label}
				</a>
			))
		}
	</nav>
</div>

<style>
	.mobile-drawer {
		width: 100%;
		height: 100%;
		margin: 0;
		border: 0;
		padding: 0;
		translate: 100% 0;
		transition:
			translate 300ms ease-out,
			display 300ms allow-discrete,
			overlay 300ms allow-discrete;
	}

	.mobile-drawer:popover-open {
		translate: 0 0;
	}

	@starting-style {
		.mobile-drawer:popover-open {
			translate: 100% 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.mobile-drawer {
			transition: none;
		}
	}
</style>

<script>
	const opener = document.querySelector<HTMLButtonElement>('.mobile-menu-open');
	const drawer = document.querySelector<HTMLElement>('.mobile-drawer');

	drawer?.addEventListener('toggle', (event) => {
		const open = (event as ToggleEvent).newState === 'open';
		document.body.classList.toggle('overflow-hidden', open);
		opener?.setAttribute('aria-expanded', String(open));
	});

	drawer?.addEventListener('click', (event) => {
		if ((event.target as HTMLElement).closest('a')) drawer.hidePopover();
	});
</script>
