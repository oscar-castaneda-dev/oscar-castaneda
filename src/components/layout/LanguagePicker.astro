---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { languages, type Lang } from '@/i18n/ui';
import { getLangFromUrl, pathWithoutLang, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const path = pathWithoutLang(Astro.url);
const entries = Object.entries(languages) as [Lang, string][];
---

{/* A <details> dropdown keeps the options as real links, so crawlers still follow them. */}
<details class="language-picker relative" data-dropdown>
	{/* The summary shows the locale code — instrument-panel short; the list spells it out. */}
	<summary
		aria-label={t('nav.switchLanguage')}
		class="nd-label flex h-9 cursor-pointer list-none items-center rounded border border-outline px-3 text-caption transition-colors duration-150 hover:text-body"
	>
		{lang}
	</summary>

	<ul class="absolute inset-e-0 z-10 mt-2 min-w-40 rounded-lg border border-outline bg-raised py-1">
		{
			entries.map(([code, label]) => (
				<li>
					<a
						href={getRelativeLocaleUrl(code, path)}
						hreflang={code}
						aria-current={code === lang ? 'true' : undefined}
						class="nd-label flex min-h-11 items-center border-s-2 border-transparent px-4 text-caption transition-colors duration-150 hover:text-body aria-current:border-accent aria-current:text-title"
					>
						{label}
					</a>
				</li>
			))
		}
	</ul>
</details>

<style>
	/* Safari still paints the default disclosure triangle without this. */
	summary::-webkit-details-marker {
		display: none;
	}
</style>

<script>
	import '@/scripts/dropdown';
</script>
