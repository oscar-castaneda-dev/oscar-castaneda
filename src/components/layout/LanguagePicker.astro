---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { languages, type Lang } from '@/i18n/ui';
import { getLangFromUrl, pathWithoutLang, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const path = pathWithoutLang(Astro.url);
const entries = Object.entries(languages) as [Lang, string][];
---

{/* A <details> dropdown keeps the options as real links, so crawlers still follow them. */}
<details class="language-picker relative flex" data-dropdown>
	{/*
	  A cell in the header rail, not a button: a full-height divider on the start
	  edge, the field name in caption grey and the current value in title.
	*/}
	<summary
		aria-label={t('nav.switchLanguage')}
		class="group font-nothing-subtitle flex cursor-pointer list-none items-center gap-2 border-s border-border px-4 text-caption transition-colors duration-150 md:px-6"
	>
		{/* On a phone the value alone carries the cell; the field name would crowd it. */}
		<span class="hidden sm:inline">{t('nav.language')}</span>
		<span class="font-bold text-title">{lang}</span>
	</summary>

	<ul class="absolute end-0 top-full z-10 min-w-40 border border-outline bg-raised py-1">
		{
			entries.map(([code, label]) => (
				<li>
					<a
						href={getRelativeLocaleUrl(code, path)}
						hreflang={code}
						aria-current={code === lang ? 'true' : undefined}
						class="font-nothing-subtitle flex min-h-11 items-center border-s-2 border-transparent px-4 text-caption transition-colors duration-150 hover:text-body aria-current:border-accent aria-current:text-title"
					>
						{label}
					</a>
				</li>
			))
		}
	</ul>
</details>

<style>
	/* Safari still paints the default disclosure triangle without this. */
	summary::-webkit-details-marker {
		display: none;
	}
</style>

<script>
	import '@/scripts/dropdown';
</script>
