---
import { getLangFromUrl, localizedPath, useTranslations } from '@/i18n/utils';
import LanguagePicker from './LanguagePicker.astro';
import MobileMenu from './MobileMenu.astro';
import ThemePicker from './ThemePicker.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const links = [
	{ href: localizedPath(lang, 'about'), label: t('nav.about') },
	{ href: localizedPath(lang, 'blog'), label: t('nav.blog') },
	{ href: localizedPath(lang, 'daily'), label: t('nav.daily') },
	{ href: localizedPath(lang, 'work'), label: t('nav.work') },
];

const current = Astro.url.pathname;
---

{/*
  The header stacks above the page: its dropdowns open downward over whatever
  section follows, and a hero that positions its own content would otherwise
  win on DOM order at the same z-index and swallow the lower options.
*/}
<header class="relative z-50 border-b border-border">
	<div class="container flex items-stretch justify-between">
		<!-- LOGO -->
		<a
			href={localizedPath(lang)}
			aria-label={t('nav.home')}
			class="group flex items-center py-6 font-nothing-code text-title before:content-['[_'] after:content-['_]']"
		>
			<span class="relative inline-block uppercase">
				oc
				<span
					class="absolute bottom-0 left-0 w-full border-b border-title opacity-0 transition-opacity duration-150 group-hover:opacity-100"
				></span>
			</span>
		</a>
		<!-- NAVIGATION -->
		<div class="flex items-stretch">
			<nav class="hidden items-center gap-6 py-6 pe-6 menu:flex menu:gap-8 menu:pe-8">
				{
					links.map(({ href, label }) => (
						<a
							href={href}
							aria-current={current === href ? 'page' : undefined}
							class:list={[
								'font-nothing-subtitle transition-colors duration-150',
								current === href ? 'text-accent' : 'text-title hover:underline',
							]}
						>
							/{label}
						</a>
					))
				}
			</nav>
			<!-- LANGUAGE AND THEME PICKER -->
			<LanguagePicker />
			<ThemePicker />
			<!-- MOBILE VIEW -->
			<div class="flex items-center ps-4 menu:hidden">
				<MobileMenu links={links} />
			</div>
		</div>
	</div>
</header>
