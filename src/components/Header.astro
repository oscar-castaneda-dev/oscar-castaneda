---
import { getLangFromUrl, localizedPath, useTranslations } from '@/i18n/utils';
import LanguagePicker from './LanguagePicker.astro';
import ThemePicker from './ThemePicker.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const links = [
	{ href: localizedPath(lang), label: t('nav.home') },
	{ href: localizedPath(lang, 'blog'), label: t('nav.blog') },
	{ href: localizedPath(lang, 'daily'), label: t('nav.daily') },
	{ href: localizedPath(lang, 'about'), label: t('nav.about') },
];

const current = Astro.url.pathname;
---

<header class="border-b border-gray-200 dark:border-gray-800">
	<div class="mx-auto flex max-w-2xl flex-wrap items-center gap-x-6 gap-y-3 px-4 py-4">
		<a
			href={localizedPath(lang)}
			class="font-semibold tracking-tight hover:text-blue-600 dark:hover:text-blue-400"
		>
			{t('site.name')}
		</a>

		<nav class="flex items-center gap-4 text-sm">
			{
				links.map(({ href, label }) => (
					<a
						href={href}
						aria-current={current === href ? 'page' : undefined}
						class="text-gray-600 hover:text-gray-900 aria-[current=page]:font-medium aria-[current=page]:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100 dark:aria-[current=page]:text-gray-100"
					>
						{label}
					</a>
				))
			}
		</nav>

		<div class="ms-auto flex items-center gap-2">
			<LanguagePicker />
			<ThemePicker />
		</div>
	</div>
</header>
