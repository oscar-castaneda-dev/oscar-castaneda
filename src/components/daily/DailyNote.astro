---
import { render, type CollectionEntry } from 'astro:content';
import { getLangFromUrl, localizedPath, useTranslations } from '@/i18n/utils';
import { getEntrySlug } from '@/lib/content';
import FormattedDate from '@/components/shared/FormattedDate.astro';

interface Props {
	entry: CollectionEntry<'daily'>;
	headingLevel?: 'h1' | 'h2';
	/** Listings show the note's description; the note's own page shows the body. */
	summary?: boolean;
}

const { entry, headingLevel: Heading = 'h2', summary = false } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const Content = summary ? null : (await render(entry)).Content;
const href = localizedPath(lang, `daily/${getEntrySlug(entry)}`);
const { title, pubDate, tags, description } = entry.data;
---

<article class="border-b border-gray-200 py-6 last:border-0 dark:border-gray-800">
	<header>
		<Heading class="text-lg font-medium">
			<a
				href={href}
				title={t('daily.permalink')}
				class="hover:text-blue-600 dark:hover:text-blue-400"
			>
				{title ?? <FormattedDate date={pubDate} />}
			</a>
		</Heading>
		<p class="mt-1 flex flex-wrap items-baseline gap-x-3 text-sm text-gray-500 dark:text-gray-400">
			{/* An untitled note already shows its date as the heading. */}
			{title && <FormattedDate date={pubDate} />}
			{
				tags.length > 0 && (
					<span class="flex flex-wrap gap-2">
						{tags.map((tag) => (
							<span class="rounded bg-gray-100 px-1.5 py-0.5 text-xs dark:bg-gray-800">#{tag}</span>
						))}
					</span>
				)
			}
		</p>
	</header>
	{summary && description && <p class="mt-3 text-gray-600 dark:text-gray-400">{description}</p>}
	{
		Content && (
			<div class="prose prose-gray dark:prose-invert mt-3 max-w-none">
				<Content />
			</div>
		)
	}
</article>
