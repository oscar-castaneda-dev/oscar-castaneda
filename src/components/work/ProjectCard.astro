---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import placeholder from '@/assets/placeholder.svg';

interface Props {
	entry: CollectionEntry<'work'>;
	href: string;
	/** The `grid-template-areas` name this card sits in. */
	area: string;
	/** The lead card: bigger heading, and it asks the browser for a wider image. */
	featured?: boolean;
	class?: string;
}

const { entry, href, area, featured = false, class: className } = Astro.props;
const { title, cover, coverDark, publishedDate } = entry.data;

const year = publishedDate.getFullYear();

// Every card carries an image: an entry without a `cover` borrows the placeholder.
const image = cover ?? placeholder;

const sizes = featured
	? '(min-width: 1024px) 55vw, 100vw'
	: '(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw';
---

{/*
  At rest the card is the artwork and nothing else. The scrim and the caption
  arrive with the pointer, so the grid reads as a wall of images until you go
  looking for a name.
*/}
<a
	href={href}
	style={`grid-area: ${area}`}
	class:list={[
		'group relative block min-h-60 overflow-hidden rounded-xl border border-border bg-card transition-colors duration-150 hover:border-outline',
		className,
	]}
>
	{/*
	  A `coverDark` swaps the artwork with the theme. It has to be two elements and
	  the `dark:` variant, not one `<picture>` with `prefers-color-scheme`: the theme
	  here is the `.dark` class, and a media query would ignore a manual choice.
	*/}
	<Image
		src={image}
		alt=""
		sizes={sizes}
		class:list={['absolute inset-0 size-full object-cover', coverDark && 'dark:hidden']}
	/>
	{
		coverDark && (
			<Image
				src={coverDark}
				alt=""
				sizes={sizes}
				class="absolute inset-0 hidden size-full object-cover dark:block"
			/>
		)
	}

	{/*
	  Not chrome: a scrim over the image, so the caption keeps its contrast on any
	  photo. Fixed black in both modes because it sits on the image, not on the surface.

	  At rest the card is nothing but the artwork; the caption arrives with the
	  pointer. `group-focus-visible` is what keeps that reachable from the keyboard.
	*/}
	<div
		class="absolute inset-0 bg-gradient-to-t from-black/35 via-black/12 to-black/5 opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus-visible:opacity-100"
	>
	</div>

	<div
		class="relative flex h-full min-h-60 flex-col justify-end p-5 text-white opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus-visible:opacity-100"
	>
		<div>
			<h3 class:list={[featured ? 'heading-44' : 'heading-36', 'uppercase text-white']}>
				{title}
			</h3>
			<p class="subtitle mt-2 text-xs text-white/70">{year}</p>
		</div>
	</div>
</a>
