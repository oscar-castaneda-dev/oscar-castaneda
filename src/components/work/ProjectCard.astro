---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import placeholder from '@/assets/placeholder.svg';

interface Props {
	entry: CollectionEntry<'work'>;
	href: string;
	/** The `grid-template-areas` name this card sits in. */
	area: string;
	/** Position in the listing, printed as `01`. */
	index: number;
	/** The lead card: bigger heading, and it asks the browser for a wider image. */
	featured?: boolean;
	class?: string;
}

const { entry, href, area, index, featured = false, class: className } = Astro.props;
const { title, category, cover, coverDark, publishedDate } = entry.data;

const number = String(index).padStart(2, '0');
const year = publishedDate.getFullYear();

// Every card carries an image: an entry without a `cover` borrows the placeholder.
const image = cover ?? placeholder;

const sizes = featured
	? '(min-width: 1024px) 55vw, 100vw'
	: '(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw';
---

{/*
  The card holds two states and nothing in between: the artwork, or the card
  surface with the name on it. Hover cross-fades one into the other, so no scrim
  is needed — the text never sits on the image, it replaces it.
*/}
<a
	href={href}
	style={`grid-area: ${area}`}
	class:list={[
		'group relative block min-h-60 overflow-hidden rounded-xl border border-border bg-card transition-colors duration-150 hover:border-outline',
		className,
	]}
>
	{/*
	  A `coverDark` swaps the artwork with the theme. It has to be two elements and
	  the `dark:` variant, not one `<picture>` with `prefers-color-scheme`: the theme
	  here is the `.dark` class, and a media query would ignore a manual choice.
	*/}
	<div class="absolute inset-0 transition-opacity duration-300 group-hover:opacity-0 group-focus-visible:opacity-0">
		<Image
			src={image}
			alt=""
			sizes={sizes}
			class:list={['absolute inset-0 size-full object-cover', coverDark && 'dark:hidden']}
		/>
		{
			coverDark && (
				<Image
					src={coverDark}
					alt=""
					sizes={sizes}
					class="absolute inset-0 hidden size-full object-cover dark:block"
				/>
			)
		}
	</div>

	{/*
	  Plain tokens: once the image is gone this is an ordinary card, so the type
	  comes from the neutral ramp like everywhere else. `group-focus-visible` is
	  what keeps the name reachable from the keyboard.
	*/}
	<div
		class="relative flex h-full min-h-60 flex-col justify-between p-5 opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus-visible:opacity-100"
	>
		<p class="subtitle text-xs text-caption">{number}{category && ` — ${category}`}</p>
		<div>
			<h3 class:list={[featured ? 'heading-44' : 'heading-36', 'uppercase']}>{title}</h3>
			<p class="subtitle mt-2 text-xs text-caption">{year}</p>
		</div>
	</div>
</a>
