---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;

/** `/en/blog/` and `/en/blog` both normalize to `/en/blog`. */
const normalize = (path: string) =>
	'/' +
	path
		.replace(import.meta.env.BASE_URL, '')
		.split('/')
		.filter(Boolean)
		.join('/');

const current = normalize(Astro.url.pathname);
const target = normalize(String(href));
// A section link stays active on its sub-pages; the locale root (`/en`) only
// matches exactly, otherwise it would light up on every page.
const isSection = target.split('/').filter(Boolean).length > 1;
const isActive = current === target || (isSection && current.startsWith(`${target}/`));
---

<a href={href} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		font-weight: bolder;
		text-decoration: underline;
	}
</style>
