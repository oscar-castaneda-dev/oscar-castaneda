---
import { getLangFromUrl } from '@/i18n/utils';

interface Props {
	date: Date;
}

const { date } = Astro.props;
const lang = getLangFromUrl(Astro.url);
---

<time datetime={date.toISOString().slice(0, 10)}>
	{
		/* Frontmatter carries a plain ISO date, parsed as UTC midnight: format it in
		   UTC too, or a browser west of Greenwich renders the day before. */
		date.toLocaleDateString(lang, {
			year: 'numeric',
			month: 'long',
			day: 'numeric',
			timeZone: 'UTC',
		})
	}
</time>
