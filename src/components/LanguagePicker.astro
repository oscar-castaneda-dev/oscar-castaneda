---
import { languages, type Lang } from '@/i18n/ui';
import { getLangFromUrl, localizedPath, pathWithoutLang, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const path = pathWithoutLang(Astro.url);
const entries = Object.entries(languages) as [Lang, string][];
---

<nav class="language-picker" aria-label={t('nav.switchLanguage')}>
	{
		entries.map(([code, label]) => (
			<a
				href={localizedPath(code, path)}
				hreflang={code}
				lang={code}
				aria-current={code === lang ? 'true' : undefined}
			>
				{label}
			</a>
		))
	}
</nav>
<style>
	.language-picker {
		display: flex;
		gap: 0.5em;
		align-items: center;
	}
	.language-picker a {
		padding: 0.25em 0.5em;
		color: rgb(var(--gray));
		font-size: 0.9em;
		text-decoration: none;
		border-bottom: none;
	}
	.language-picker a[aria-current='true'] {
		color: var(--black);
		font-weight: bolder;
	}
</style>
