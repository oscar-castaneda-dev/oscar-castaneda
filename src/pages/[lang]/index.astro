---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import HomeContent from '../../components/HomeContent.astro';
import { getLangFromUrl, getLangStaticPaths, useTranslations } from '../../i18n/utils';

export const getStaticPaths = getLangStaticPaths;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={t('site.title')} description={t('site.description')} />
	</head>
	<body>
		<Header />
		<main>
			<h1>{t('home.heading')}</h1>
			<HomeContent lang={lang} />
		</main>
		<Footer />
	</body>
</html>
