---
import { Image } from 'astro:assets';
import FormattedDate from '@/components/FormattedDate.astro';
import Layout from '@/layouts/Layout.astro';
import { getLangFromUrl, getLangStaticPaths, localizedPath, useTranslations } from '@/i18n/utils';
import { getEntrySlug, getLocalizedEntries } from '@/lib/content';

export const getStaticPaths = getLangStaticPaths;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const posts = await getLocalizedEntries('blog', lang);
---

<Layout title={t('site.title')} description={t('site.description')}>
	<section>
		<ul>
			{
				posts.map((post) => (
					<li>
						<a href={localizedPath(lang, `blog/${getEntrySlug(post)}`)}>
							{post.data.heroImage && (
								<Image width={720} height={360} src={post.data.heroImage} alt="placeholder" />
							)}
							<h4>{post.data.title}</h4>
							<p>
								<FormattedDate date={post.data.pubDate} />
							</p>
						</a>
					</li>
				))
			}
		</ul>
	</section>
</Layout>

