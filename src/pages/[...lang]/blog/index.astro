---
import { Image } from 'astro:assets';
import FormattedDate from '@/components/shared/FormattedDate.astro';
import Layout from '@/layouts/Layout.astro';
import { getLangFromUrl, getLangStaticPaths, localizedPath, useTranslations } from '@/i18n/utils';
import { getEntrySlug, getLocalizedEntries } from '@/lib/content';

export const getStaticPaths = getLangStaticPaths;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const posts = await getLocalizedEntries('blog', lang);
---

<Layout title={`${t('blog.title')} | ${t('site.title')}`} description={t('blog.description')} class="container py-12">
	<div class="mx-auto max-w-2xl">
		<h1 class="text-3xl font-bold tracking-tight">{t('blog.title')}</h1>
		<p class="mt-3 text-gray-600 dark:text-gray-400">{t('blog.description')}</p>

		{
		posts.length > 0 ? (
			<ul class="mt-10 space-y-10">
				{posts.map((post) => (
					<li>
						<a href={localizedPath(lang, `blog/${getEntrySlug(post)}`)} class="group block">
							{post.data.heroImage && (
								<Image
									width={720}
									height={360}
									src={post.data.heroImage}
									alt=""
									class="mb-3 aspect-2/1 w-full rounded-lg object-cover"
								/>
							)}
							<h2 class="text-lg font-medium group-hover:text-blue-600 dark:group-hover:text-blue-400">
								{post.data.title}
							</h2>
							<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
								<FormattedDate date={post.data.publishedDate} />
							</p>
							<p class="mt-2 text-gray-600 dark:text-gray-400">{post.data.description}</p>
						</a>
					</li>
				))}
			</ul>
		) : (
			<p class="mt-10 text-gray-500 dark:text-gray-400">{t('blog.empty')}</p>
		)
		}
	</div>
</Layout>
