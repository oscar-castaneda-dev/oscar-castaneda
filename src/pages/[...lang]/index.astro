---
import Counter from '@/components/Counter';
import Layout from '@/layouts/Layout.astro';
import { getLangFromUrl, getLangStaticPaths, useTranslations } from '@/i18n/utils';

export const getStaticPaths = getLangStaticPaths;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={t('site.title')} description={t('site.description')}>
	<h1 class="text-3xl font-bold tracking-tight">{t('home.heading')}</h1>
	<p class="mt-3 text-gray-600 dark:text-gray-400">{t('home.intro')}</p>
	<Counter client:load />
</Layout>
