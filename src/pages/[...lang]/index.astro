---
import HomeGrid from '@/components/home/HomeGrid.astro';
import HomeHero from '@/components/home/HomeHero.astro';
import Layout from '@/layouts/Layout.astro';
import { getLangFromUrl, getLangStaticPaths, useTranslations } from '@/i18n/utils';

export const getStaticPaths = getLangStaticPaths;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={t('site.title')} description={t('site.description')}>
	<HomeHero />
	<HomeGrid />
</Layout>
