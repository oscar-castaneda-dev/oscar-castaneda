---
import { type CollectionEntry } from 'astro:content';
import DailyNote from '@/components/daily/DailyNote.astro';
import Layout from '@/layouts/Layout.astro';
import { languages, type Lang } from '@/i18n/ui';
import { getLangFromUrl, langParam, localizedPath, useTranslations } from '@/i18n/utils';
import { getEntrySlug, getLocalizedEntries } from '@/lib/content';

export async function getStaticPaths() {
	const langs = Object.keys(languages) as Lang[];
	const paths = await Promise.all(
		langs.map(async (lang) => {
			const notes = await getLocalizedEntries('daily', lang);
			return notes.map((entry) => ({
				params: { lang: langParam(lang), slug: getEntrySlug(entry) },
				props: entry,
			}));
		}),
	);
	return paths.flat();
}
type Props = CollectionEntry<'daily'>;

const entry = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
// An untitled note falls back to its date, formatted for the current locale.
const title = entry.data.title ?? entry.data.pubDate.toLocaleDateString(lang, { dateStyle: 'long' });
---

<Layout
	title={`${title} | ${t('daily.title')}`}
	description={entry.data.description ?? t('daily.description')}
>
	<div class="mx-auto max-w-2xl">
		<a
			href={localizedPath(lang, 'daily')}
			class="text-sm text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100"
		>
			&larr; {t('daily.title')}
		</a>
		<DailyNote entry={entry} headingLevel="h1" />
	</div>
</Layout>

