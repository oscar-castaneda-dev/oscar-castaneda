---
import DailyNote from '@/components/DailyNote.astro';
import Layout from '@/layouts/Layout.astro';
import { getLangFromUrl, getLangStaticPaths, useTranslations } from '@/i18n/utils';
import { getLocalizedEntries } from '@/lib/content';

export const getStaticPaths = getLangStaticPaths;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const notes = await getLocalizedEntries('daily', lang);
---

<Layout title={`${t('daily.title')} | ${t('site.title')}`} description={t('daily.description')}>
	<h1 class="text-3xl font-bold tracking-tight">{t('daily.title')}</h1>
	<p class="mt-3 text-gray-600 dark:text-gray-400">{t('daily.description')}</p>
	{
		notes.length > 0 ? (
			<div class="mt-8">
				{notes.map((entry) => (
					<DailyNote entry={entry} />
				))}
			</div>
		) : (
			<p class="mt-8 text-gray-500 dark:text-gray-400">{t('daily.empty')}</p>
		)
	}
</Layout>

