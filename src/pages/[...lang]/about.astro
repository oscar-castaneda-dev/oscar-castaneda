---
import { getLangFromUrl, getLangStaticPaths, useTranslations } from '@/i18n/utils';
import Layout from '@/layouts/Layout.astro';

export const getStaticPaths = getLangStaticPaths;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={t('about.title')} description={t('about.description')}>
	<h1 class="text-3xl font-bold tracking-tight">{t('about.heading')}</h1>
	<div class="prose prose-gray dark:prose-invert mt-6 max-w-none">
		<p>{t('about.body')}</p>
	</div>
</Layout>
